# NOTE: No server-side Gemini API key is used or stored here.
# Metadata generation strictly requires each visitor to provide their own Gemini API key
# directly in the browser settings (stored only in client localStorage).
# If a generation request arrives without a visitor key, the server rejects it with HTTP 400.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
